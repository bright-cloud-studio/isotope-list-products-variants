{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_figure.html.twig' %}

{% block content %}
    <div class="product_list" data-alias="{{ page_alias }}" data-id="{{ page_id }}">
        {% for variant in variants %}
            <div class="product product_{{ variant.count }}" id="product_{{ variant.id }}">
                {% if variant.image %}
                    {# Size is required by figure(); null keeps the original, matching the
                       empty main_size on the product galleries this page used in Contao 4 #}
                    {% set image = figure(variant.image, null) %}
                    {% if image %}
                        {% with {figure: image} %}{{ block('figure_component') }}{% endwith %}
                    {% endif %}
                {% endif %}

                <div class="product_info_wrapper">
                    <div class="product_info">
                        <h3 itemprop="name">{{ variant.name }}</h3>
                        {% if variant.bristle %}
                            <div class="bristle">&nbsp;&nbsp;&bull;&nbsp;&nbsp;{{ variant.bristle }}</div>
                        {% endif %}
                        {% if variant.sizes %}
                            <div class="sizes">Sizes: {{ variant.sizes }}</div>
                        {% endif %}
                    </div>

                    {% if variant.children %}
                        <div class="toggles">
                            <button type="button" class="variant_toggle variant_toggle_{{ variant.id }}" aria-expanded="false" aria-controls="dimentions_{{ variant.id }}">
                                Dimensions <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                    {% endif %}
                </div>

                {% if variant.children %}
                    <div class="dimentions_wrapper dimentions_wrapper_{{ variant.id }}" id="dimentions_{{ variant.id }}" hidden>
                        <div class="dimentions">
                            {% for unit in [
                                {label: 'Inches', length: 'length', width: 'width'},
                                {label: 'Millimeters', length: 'mm_length', width: 'mm_width'}
                            ] %}
                                <table class="{{ unit.label|lower }}">
                                    <caption>{{ unit.label }}</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Size</th>
                                            <th scope="col">Length</th>
                                            <th scope="col">Width</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for child in variant.children %}
                                            <tr class="variant variant_{{ child.id }}">
                                                <td>{{ child.size }}</td>
                                                <td>{{ attribute(child, unit.length) }}</td>
                                                <td>{{ attribute(child, unit.width) }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {# The Contao 4 version relied on an inline onClick and jQuery UI's blind effect,
       loaded from a CDN by the theme's js_variant_toggle template. Ship the behaviour
       with the element instead, animating the height directly so nothing but the
       element itself is needed. Delegated from the document and guarded, so several
       elements on one page cannot bind the same button twice. #}
    <script>
        if (!window.bcsVariantToggle) {
            window.bcsVariantToggle = true;

            var bcsVariantSlide = function (target, open) {

                // Clip and animate the height, which is what the blind effect did
                target.style.overflow = 'hidden';
                target.style.transition = 'height 300ms ease';

                if (open) {
                    target.hidden = false;
                    target.style.height = '0px';
                } else {
                    target.style.height = target.scrollHeight + 'px';
                }

                // Force a reflow so the browser animates from the height just set
                void target.offsetHeight;

                target.style.height = open ? target.scrollHeight + 'px' : '0px';

                // Hand the height back to the stylesheet once the slide has finished
                window.setTimeout(function () {
                    target.style.removeProperty('transition');
                    target.style.removeProperty('overflow');
                    target.style.removeProperty('height');

                    if (!open) {
                        target.hidden = true;
                    }
                }, 300);
            };

            document.addEventListener('click', function (event) {
                var button = event.target.closest('.variant_toggle');

                if (!button) {
                    return;
                }

                var target = document.getElementById(button.getAttribute('aria-controls'));
                var open = button.getAttribute('aria-expanded') !== 'true';

                button.setAttribute('aria-expanded', String(open));
                bcsVariantSlide(target, open);
            });
        }
    </script>
{% endblock %}
